# 模型凭证：examples/collective_memory.py 的在线判定与
# tests/unit/control/test_middle_e2e_real_llm.py 读取同一组变量。
# 复制为 .env 后填写（.env 已在 .gitignore 内，不会提交）。
# 三项任一为空即回落离线实现，不报错。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
# 可选：LlmProducer 实现名，缺省 openai。
# 默认开思考模式的模型（GLM、Qwen3 等）取 dashscope，请求体才会带 enable_thinking=false。
LLM_TARGET=
