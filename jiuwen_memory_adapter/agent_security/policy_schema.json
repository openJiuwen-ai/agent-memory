{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindVault SDK egress policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "default": "policy-1"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "hooks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "BEFORE_LLM_CALL",
                "BEFORE_TOOL_CALL",
                "BEFORE_AGENT_RESPONSE",
                "BEFORE_AGENT_MESSAGE"
              ]
            },
            "default": [
              "BEFORE_LLM_CALL",
              "BEFORE_TOOL_CALL",
              "BEFORE_AGENT_RESPONSE",
              "BEFORE_AGENT_MESSAGE"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "default": [
              "*"
            ]
          },
          "max_level": {
            "type": "string",
            "enum": [
              "S1",
              "S2",
              "S3"
            ],
            "default": "S3"
          },
          "allow_original": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
