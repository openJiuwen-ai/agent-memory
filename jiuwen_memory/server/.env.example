# ========== LLM Configuration ==========
# LLM Provider (SiliconFlow, OpenAI, etc.)
MODEL_PROVIDER=

# LLM API Base URL
API_BASE=

# LLM API Key (set your actual API key here)
API_KEY=

# LLM Model Name
MODEL_NAME=

# 是否校验 LLM API 的 TLS 证书；默认不校验，设为 true 时开启
MODEL_SSL_VERIFY=false

# ========== Embedding Configuration ==========
# Embedding Model Name
EMBED_MODEL_NAME=

# Embedding API Base URL
EMBED_API_BASE=

# Embedding API Key
EMBED_API_KEY=

# ========== Server Configuration ==========
# 记忆数据文件保存目录
MEMORY_DATA_DIR=./memory_data

# 记忆服务监听 IP，默认 127.0.0.1（仅本机访问，对外暴露请改 0.0.0.0 并设置 MEMORY_API_KEY）
IP=127.0.0.1

# 记忆服务监听端口，默认 8000
PORT=8000

# API 鉴权 Key（设置后所有写/删接口需携带 Authorization: Bearer <key>；留空则不鉴权，仅限本地开发）
MEMORY_API_KEY=

# ========== MCP Server Configuration ==========
# MCP 服务默认操作的 user_id / scope_id（工具参数仍可逐次覆盖；留空则使用引擎默认值 __default__）
MCP_DEFAULT_USER_ID=
MCP_DEFAULT_SCOPE_ID=

# MCP 传输方式: http（默认，常驻 Streamable HTTP 服务）| sse（常驻 SSE 服务）
MCP_TRANSPORT=http
# MCP 服务独立监听地址与端口（与 memory_server 的 IP/PORT 分离，默认 127.0.0.1:8765）
# http 端点: http://<MCP_HOST>:<MCP_PORT>/mcp   sse 端点: http://<MCP_HOST>:<MCP_PORT>/sse
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ========== Store Configuration ==========
# SQLAlchemy 异步连接 URL；KV(db 模式) 与 DB store 共用。
# 留空则回退到 sqlite+aiosqlite:///${MEMORY_DATA_DIR}/sqlite_db.db
DB_URL=

# ---------- KV Store ----------
# 可选值: db | in_memory | shelve （默认 db）
KV_STORE_TYPE=db
# 仅当 KV_STORE_TYPE=shelve 时生效，留空默认 ${MEMORY_DATA_DIR}/shelve_kv
KV_SHELVE_PATH=

# ---------- DB Store ----------
# 可选值: default | gauss （默认 default）
DB_STORE_TYPE=default

# ---------- Memory Index Backend ----------
# 可选值: simple | file （默认 simple）
# - simple: 向量后端（KV+Vector），引擎原有行为
# - file:   markdown + SQLite 文件后端（FileMemoryIndex），需配合 FILE_MEMORY_DATA_DIR
#           file 模式下长期记忆落 markdown 文件；若需中间记忆 / dreaming，仍需配置 VECTOR_STORE_TYPE
# 选 file 时需安装可选依赖（缺失会静默降级：中文分词变弱、外部编辑不同步）：
#   pip install JiuwenMemory[file-index]   # sqlite-vec + watchdog + jieba
INDEX_BACKEND=simple
# FileMemoryIndex 数据根目录（仅 INDEX_BACKEND=file 时生效，留空默认 ~/.jiuwenmemory/file_memory_data）
FILE_MEMORY_DATA_DIR=

# ---------- Vector Store ----------
# 可选值: chroma | milvus | elasticsearch | gauss （默认 chroma）
# INDEX_BACKEND=file 时，Vector Store 仅用于中间记忆 / dreaming，可不配
VECTOR_STORE_TYPE=chroma

# -- chroma --
# 留空默认 ${MEMORY_DATA_DIR}
VECTOR_CHROMA_PERSIST_DIR=

# -- milvus --（仅 VECTOR_STORE_TYPE=milvus 时需要）
VECTOR_MILVUS_URI=
VECTOR_MILVUS_TOKEN=
VECTOR_MILVUS_DATABASE=default

# -- elasticsearch --（仅 VECTOR_STORE_TYPE=elasticsearch 时需要）
# 逗号分隔，例如 http://localhost:9200,http://localhost:9201
VECTOR_ES_HOSTS=
VECTOR_ES_INDEX_PREFIX=agent_vector

# -- gauss vector --（仅 VECTOR_STORE_TYPE=gauss 时需要）
VECTOR_GAUSS_HOST=localhost
VECTOR_GAUSS_PORT=5432
VECTOR_GAUSS_DATABASE=postgres
VECTOR_GAUSS_USER=postgres
VECTOR_GAUSS_PASSWORD=
