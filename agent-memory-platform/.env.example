# agent-memory-platform — Docker Compose 环境变量模板
# 用法：
#   cp .env.example .env   （切勿提交 .env）
#   docker compose up -d --build
#
# 说明：
#   - 此文件覆盖 agent-memory-platform/docker-compose.yml 中 ${VAR:-default} 形式的变量
#   - 记忆服务（被调用方）的实际地址 / 密钥以 deploy/.env 为准：
#       HOST_PORT=8516  →  PLATFORM_MEMORY_SERVICE_BASE_URL 端口
#       MEMORY_API_KEY  →  PLATFORM_MEMORY_SERVICE_API_KEY
#   - api-key 不要带 "Bearer " 前缀，WebClientConfig.java:54 会自动补

# === Spring 配置 ===
# 数据库 profile：sqlite / mysql / gaussdb
# sqlite：单文件库挂载到 ./platform/data/platform.db（默认）
# mysql ：需注入 MYSQL_URL / MYSQL_USER / MYSQL_PASSWORD
SPRING_PROFILES_ACTIVE=sqlite

# === 记忆服务连接（对应 application.yml: platform.memory-service.{base-url, api-key}）===
# 调用 deploy/ 下启动的 JiuwenMemory FastAPI 引擎
# 实际值取自 deploy/.env：HOST_PORT 决定端口，IP 为记忆服务所在宿主机
PLATFORM_MEMORY_SERVICE_BASE_URL=http://your-memory-host:8516
# 实际值取自 deploy/.env 的 MEMORY_API_KEY，二者必须一致，否则 POST 返回 401
PLATFORM_MEMORY_SERVICE_API_KEY=

# === JVM 参数 ===
JAVA_OPTS=-Dfile.encoding=UTF-8
