# JiuwenMemory — Docker deployment env template.
# cp .env.example .env  (never commit .env)

# === Service ===
# HOST_IP: [::] (dual-stack, prod) | 127.0.0.1 (local dev only)
HOST_IP=127.0.0.1
# Container-internal IP/port (must be 0.0.0.0 / match ports mapping right side).
IP=0.0.0.0
# Host port exposed by docker-compose (left side of "HOST_PORT:8000").
HOST_PORT=8001
# PORT / CONTAINER_PORT below are used only by deploy.sh (compose hardcodes
# container port 8000). Keep PORT in sync with HOST_PORT to avoid confusion.
PORT=8001
CONTAINER_PORT=8000

# === Data persistence ===
# Volume mount target inside the container.
MEMORY_DATA_DIR=/app/memory_data

# === Embedding model ===
EMBED_MODEL_NAME=your-embedding-model-name
EMBED_API_KEY=your-embedding-api-key-here
EMBED_API_BASE=https://your-embedding-api-base/v1/embeddings

# === LLM model ===
MODEL_NAME=your-llm-model-name
MODEL_PROVIDER=your-llm-provider
API_KEY=your-llm-api-key-here
API_BASE=https://your-llm-api-base/v1

# === API auth ===
# Set a random bearer secret for write/delete endpoints; empty = no auth.
MEMORY_API_KEY=

# === Stores ===
KV_STORE_TYPE=in_memory
DB_STORE_TYPE=gauss
# GaussDB URL (encode @ in password as %40)
DB_URL=gaussdb://username:password@host:port/dbname
VECTOR_STORE_TYPE=elasticsearch
# Elasticsearch
VECTOR_ES_HOSTS=http://your-es-host:port
VECTOR_ES_INDEX_PREFIX=agent_vector
VECTOR_ES_USERNAME=elastic
VECTOR_ES_PASSWORD=your-es-password-here
# Chroma persist dir (defaults to MEMORY_DATA_DIR)
VECTOR_CHROMA_PERSIST_DIR=/app/memory_data

# === Java integration (spring-ai-ascend) ===
# On the same Docker network, Java side uses:
#   MEM0_BASE_URL=http://agent-memory:8000
# Java containers use internal port 8000; host port is 8001.
