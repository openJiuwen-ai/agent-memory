# Copy to .env and fill real secrets:
#   cp .env.example .env

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_ENABLE_THINKING=false

MODEL_API_TOKEN=
EMBEDDER_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
EMBEDDER_BASE_URL=
RERANKER_BASE_URL=
RERANKER_DIALECT=cohere

ES_HOSTS=http://elasticsearch:9200
ES_INDEX=agent_memory_fulltext
ES_INDEX_L0=agent_memory_fulltext_l0
ES_INDEX_L1=agent_memory_fulltext_l1
ES_TEXT_ANALYZER=english

# Local PostgreSQL service. Keep the password URI-safe because config.yml
# builds the application DSN from these three values.
POSTGRES_DB=agent_memory
POSTGRES_USER=agent_memory
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

PG_SCHEMA=public
PG_KV_TABLE=agent_memory_kv
PG_VECTOR_TABLE=agent_memory_vectors
PG_VECTOR_TABLE_L0=agent_memory_vectors_l0
PG_VECTOR_TABLE_L1=agent_memory_vectors_l1

# SSL（对接云端托管实例时启用）。
# ssl_verify 只控制是否校验服务端证书；启用时对应的 *_SSL_CA 必填。
#   pg → 参数形态开关，开启后内部置 sslmode=verify-full
#   ES → 须同时把 ES_HOSTS 换成 https://，否则装配阶段报错
# 证书需挂载进容器，路径为容器内路径，例如 volumes: [ "./certs:/certs:ro" ]。
# TLS 默认校验主机名，连接串请用域名而非 IP。
PG_SSL_VERIFY=false
PG_SSL_CA=
ES_SSL_VERIFY=false
ES_SSL_CA=
