# 复制为 .env 后填入真实值：  cp .env.example .env
# compose 通过 env_file 把这些注入应用容器，config.yml 里的 ${VAR} 据此展开。

# —— HTTP 开发功能测试（生产环境保持 required）——
JIUWEN_MEMORY_HTTP_AUTH_MODE=required
HTTP_BIND_ADDRESS=127.0.0.1

# —— 阿里云 DashScope LLM（OpenAI 兼容）——
# 必填：你的 API Key（留空可启动，但 LLM 相关算子调用时会失败）
LLM_API_KEY=
# 选填：默认中国（北京）公共端点 + qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# false（默认）关闭思考；true 开启；null 不传厂商字段
LLM_ENABLE_THINKING=false

# —— 本地嵌入/精排模型（进程内 bge）——
# 须先通过 ModelScope 预下载到 deploy/docker/models（见 README，或运行 ./download-models.sh），
# compose 将该目录挂载到容器 /models-local。此处为容器内目录路径 → 直接离线加载，不联网。
EMBED_MODEL=/models-local/bge-m3
RERANK_MODEL=/models-local/bge-reranker-v2-m3

# —— 后端连接串（默认即 compose 内部服务名，一般无需改）——
REDIS_URL=redis://redis:6379/0
ES_HOSTS=http://elasticsearch:9200
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=agent_memory_vectors
