# Copy to .env and fill real secrets:
#   cp .env.example .env

# Cloud LLM (OpenAI-compatible).
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-plus

# Remote embedding/rerank model service.
# Required: use your own HTTPS endpoint.
# EMBEDDER_BASE_URL must include /v1; RERANKER_BASE_URL must not include /rerank.
MODEL_API_TOKEN=
EMBEDDER_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
EMBEDDER_BASE_URL=
RERANKER_BASE_URL=
RERANKER_DIALECT=cohere

# Backend connections. Defaults match docker-compose service names.
REDIS_URL=redis://redis:6379/0
ES_HOSTS=http://elasticsearch:9200
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=agent_memory_vectors
