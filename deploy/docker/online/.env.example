# Copy to .env and fill real secrets:
#   cp .env.example .env

# Alibaba Cloud DashScope LLM (OpenAI-compatible).
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# false (default) disables thinking; true enables it; null omits the vendor field.
LLM_ENABLE_THINKING=false

# Remote embedding/rerank model service.
# Required: use your own HTTPS endpoint.
# EMBEDDER_BASE_URL must include /v1; RERANKER_BASE_URL must not include /rerank.
MODEL_API_TOKEN=
EMBEDDER_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
EMBEDDER_BASE_URL=
RERANKER_BASE_URL=
RERANKER_DIALECT=cohere

# Backend connections. Defaults match docker-compose service names.
REDIS_URL=redis://redis:6379/0
ES_HOSTS=http://elasticsearch:9200
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=agent_memory_vectors

# SSL（对接云端托管实例时启用）。
# ssl_verify 只控制是否校验服务端证书；加密开关在连接串上：
#   redis  → REDIS_URL 换 rediss:// scheme（端口通常也随之改变）
#   ES     → ES_HOSTS 换 https://
#   milvus → 参数形态开关，uri 用 http/https 皆可
# 启用任一 *_SSL_VERIFY=true 时，对应的 *_SSL_CA 必填，否则装配阶段直接报错。
# 证书为云厂商控制台下载的 CA 证书，需挂载进容器且路径为容器内路径，例如：
#   volumes: [ "./certs:/certs:ro" ]
# 另外 TLS 默认校验主机名，连接串请使用域名而非 IP，否则证书 CN/SAN 对不上。
REDIS_SSL_VERIFY=false
REDIS_SSL_CA=
ES_SSL_VERIFY=false
ES_SSL_CA=
MILVUS_SSL_VERIFY=false
MILVUS_SSL_CA=

# 模型服务 SSL（LLM / embedder / reranker）。
# ssl_verify 只控制是否接管信任锚；加密开关在各自 base_url 的 scheme 上。
#   开发自测：保持 false，可直连 http:// 部署的本地模型服务
#   生产    ：设 true，此时对应 base_url 必须是 https://，否则装配阶段报错
# 公网端点（DashScope 等）证书由公共 CA 签发，*_SSL_CA 留空即可；
# 私有部署且证书自签时填容器内的 CA 证书路径（需 volume 挂载，文件不存在会装配报错）。
LLM_SSL_VERIFY=false
LLM_SSL_CA=
EMBEDDER_SSL_VERIFY=false
EMBEDDER_SSL_CA=
RERANKER_SSL_VERIFY=false
RERANKER_SSL_CA=
